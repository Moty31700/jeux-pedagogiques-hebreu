'use strict';

/* ============================================================
   DATA — Analyses syntaxiques détaillées
   ============================================================ */

// --- Helper for safe HTML
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ===== FRANÇAIS — extraits courts pour analyse (paraphrases pédagogiques) ===== */

const FR_VERSES = [
  {
    n: 1, c: 1,
    fr: "Bien sûr, nous eûmes des orages",
    structure: "Proposition principale avec adverbial modalisateur en tête.",
    words: [
      { tok: "Bien sûr", gem: true, desc: "<b>locution adverbiale épistémique</b> — connecteur de <i>concession anticipée</i>. <span class='meaning'>≈ certes (sous-entend : « mais… »)</span>" },
      { tok: "nous", desc: "<b>pronom personnel</b>, 1ʳᵉ pers. pl., sujet" },
      { tok: "eûmes", gem: true, desc: "<b>verbe avoir</b>, <i>passé simple</i> 1ʳᵉ pers. pl. <span class='meaning'>Temps narratif littéraire qui inscrit l'événement dans un passé révolu. Très marqué stylistiquement à la 1ʳᵉ personne.</span>" },
      { tok: "des orages", desc: "<b>groupe nominal</b>, COD — <i>des</i> = article indéfini pluriel. <span class='meaning'>Métaphore : conflits amoureux.</span>" }
    ],
    note: { label: "Stylistique", text: "Le <b>bien sûr</b> ouvre une anaphore concessive qui structure tout le poème (vers 1, 21, 31)." }
  },
  {
    n: 2, c: 1,
    fr: "Vingt ans d'amour, c'est l'amour fol",
    structure: "Phrase nominale segmentée — <b>dislocation à gauche</b> et reprise par <i>c'</i>.",
    words: [
      { tok: "Vingt ans d'amour", desc: "<b>groupe nominal en thématisation</b>, détaché en tête. <span class='meaning'><i>de</i> élidé : complément du nom.</span>" },
      { tok: "c'", desc: "<b>pronom démonstratif neutre</b>, sujet de reprise — anaphorique." },
      { tok: "est", desc: "<b>verbe être</b>, copule, présent <i>gnomique</i>." },
      { tok: "l'amour fol", gem: true, desc: "<b>attribut du sujet</b> — <i>fol</i> = forme <b>archaïque/poétique</b> de <i>fou</i> devant voyelle. <span class='meaning'>Cf. bel, vieil, nouvel. Registre soutenu.</span>" }
    ],
    note: { label: "Rhétorique", text: "La dislocation crée un effet de <b>maxime gnomique</b>, une sentence universelle." }
  },
  {
    n: 3, c: 1,
    fr: "Mille fois, tu pris ton bagage",
    structure: "Proposition avec adverbial antéposé emphatique.",
    words: [
      { tok: "Mille fois", desc: "<b>locution adverbiale</b> de fréquence, <i>hyperbolique</i>." },
      { tok: "tu pris", desc: "<b>verbe prendre</b>, passé simple 2ᵉ pers. sing." },
      { tok: "ton bagage", desc: "<b>GN COD</b> — déterminant possessif + nom." }
    ]
  },
  {
    n: 4, c: 1,
    fr: "Mille fois, je pris mon envol",
    structure: "Proposition parallèle à la précédente (parallélisme + antithèse).",
    words: [
      { tok: "mon envol", gem: true, desc: "<b>GN COD</b> — <i>prendre son envol</i> est une <b>locution figée</b>. <span class='meaning'>= s'enfuir, partir. Métaphore aviaire qui contraste avec le concret <i>bagage</i>.</span>" }
    ],
    note: { label: "Antithèse", text: "Le parallélisme <b>tu / je</b> et l'opposition <b>bagage / envol</b> (concret / métaphorique) construisent une <b>antithèse symétrique</b>." }
  },
  {
    n: 5, c: 2,
    fr: "Et chaque meuble se souvient",
    structure: "Proposition principale coordonnée — <b>personnification</b>.",
    words: [
      { tok: "chaque meuble", desc: "<b>GN sujet</b> — <i>chaque</i> = déterminant distributif." },
      { tok: "se souvient", gem: true, desc: "<b>verbe pronominal</b>, présent. <span class='meaning'>Le pronom <i>se</i> est <i>essentiellement réfléchi</i> — le verbe n'existe pas sans lui.</span>" }
    ]
  },
  {
    n: 6, c: 2,
    fr: "Dans cette chambre sans berceau",
    structure: "Groupe prépositionnel circonstanciel de lieu.",
    words: [
      { tok: "sans berceau", gem: true, desc: "<b>GP adjectival</b>, complément du nom <i>chambre</i> — <i>sans</i> introduit une <b>détermination négative</b>. <span class='meaning'>Le berceau évoque par métonymie l'enfant absent — détail bouleversant et discret.</span>" }
    ]
  },
  {
    n: 7, c: 2,
    fr: "Des éclats, des vieilles tempêtes",
    structure: "Groupe nominal — COI de <i>se souvenir de</i>.",
    words: [
      { tok: "Des", desc: "<b>article</b> — devrait être <i>de</i> devant adjectif antéposé pluriel en français normé ; <i>des</i> ici = <b>usage poétique</b>." },
      { tok: "éclats", gem: true, desc: "<b>nom masc. pl.</b> <span class='meaning'>Polysémie : éclats de voix, de colère, mais aussi éclats lumineux.</span>" },
      { tok: "vieilles tempêtes", desc: "<b>adjectif antéposé</b> + nom — <i>vieilles</i> antéposé prend une valeur affective." }
    ]
  },
  {
    n: 8, c: 2,
    fr: "Plus rien ne ressemblait à rien",
    structure: "Proposition à l'imparfait avec <b>double négation absolue</b>.",
    words: [
      { tok: "Plus rien", desc: "<b>locution pronominale négative</b>, sujet — <i>plus</i> + <i>rien</i>." },
      { tok: "ressemblait", desc: "<b>verbe ressembler</b>, imparfait — état durable au passé." },
      { tok: "à rien", gem: true, desc: "<b>COI</b> (régime : <i>ressembler à</i>). <span class='meaning'>La répétition <i>rien… à rien</i> crée une <b>tautologie négative</b> d'une grande force expressive.</span>" }
    ]
  },
  {
    n: 9, c: 2,
    fr: "Tu avais perdu le goût de l'eau",
    structure: "Proposition au <b>plus-que-parfait</b>.",
    words: [
      { tok: "avais perdu", desc: "<b>plus-que-parfait</b> — temps de l'antériorité dans le passé." },
      { tok: "le goût de l'eau", gem: true, desc: "<b>GN COD</b> — <i>avoir le goût de</i> = <i>avoir le penchant pour</i>. <span class='meaning'>L'eau symbolise la pureté, la simplicité, la quotidienneté.</span>" }
    ]
  },
  {
    n: 10, c: 2,
    fr: "Et moi celui de la conquête",
    structure: "Proposition parallèle avec <b>ellipse</b> du verbe.",
    words: [
      { tok: "Et moi", desc: "<b>pronom tonique</b> en dislocation — opposition avec <i>tu</i>." },
      { tok: "celui", gem: true, desc: "<b>pronom démonstratif</b> masc. sing., reprend <i>le goût</i>. <span class='meaning'>L'ellipse est un procédé d'<b>économie poétique</b>.</span>" }
    ]
  },
  {
    n: 11, c: 3,
    fr: "Mais mon amour / Mon doux, mon tendre, / Mon merveilleux amour",
    structure: "Apostrophe en <b>gradation ternaire</b>.",
    words: [
      { tok: "Mais", desc: "<b>conjonction adversative</b> — marque le retournement annoncé par <i>bien sûr</i>." },
      { tok: "mon doux, mon tendre", gem: true, desc: "<b>adjectifs substantivés</b> par le possessif. <span class='meaning'>Emploi rare et poétique : <i>doux</i> et <i>tendre</i> deviennent des noms.</span>" },
      { tok: "merveilleux", desc: "<b>adjectif antéposé</b> superlatif — typique du registre poétique." }
    ],
    note: { label: "Gradation", text: "<b>doux → tendre → merveilleux</b> construit un <b>crescendo affectif</b>." }
  },
  {
    n: 12, c: 3,
    fr: "De l'aube claire jusqu'à la fin du jour",
    structure: "Locution prépositionnelle corrélative <b>de… jusqu'à…</b> — durée totale.",
    words: [
      { tok: "De … jusqu'à", gem: true, desc: "<b>corrélation temporelle</b> — équivalent direct de l'hébreu <i>מ… עד…</i>. <span class='meaning'>Trace un arc temporel embrassant la journée entière.</span>" },
      { tok: "l'aube claire", desc: "<b>GN</b> — <i>claire</i> adjectif postposé épithète." }
    ]
  },
  {
    n: 13, c: 3,
    fr: "Je t'aime encore, tu sais, je t'aime",
    structure: "Deux propositions avec <b>incise</b> et <b>épanadiplose</b>.",
    words: [
      { tok: "encore", gem: true, desc: "<b>adverbe temporel</b> — marque la <b>persistance</b>. <span class='meaning'>Équivalent direct de l'hébreu <i>עדיין</i>.</span>" },
      { tok: "tu sais", gem: true, desc: "<b>proposition incise phatique</b> — interpelle l'interlocutrice. <span class='meaning'>Crée une <b>intimité orale</b> au sein du poème.</span>" }
    ],
    note: { label: "Structure", text: "La répétition <b>je t'aime … je t'aime</b> en clôture est une <b>épanadiplose</b>." }
  },
  {
    n: 14, c: 4,
    fr: "Moi, je sais tous tes sortilèges",
    structure: "Dislocation à gauche + chiasme pronominal avec le vers suivant.",
    words: [
      { tok: "Moi, je sais", desc: "<b>dislocation</b> avec pronom tonique de reprise — emphase." },
      { tok: "sortilèges", gem: true, desc: "<b>nom masc. pl.</b> — opérations magiques, charmes occultes. <span class='meaning'>De <i>sort</i> + suffixe <i>-ilège</i> d'origine latine.</span>" }
    ]
  },
  {
    n: 15, c: 4,
    fr: "Tu sais tous mes envoûtements",
    structure: "Symétrie inverse — <b>chiasme</b> <i>je…tes / tu…mes</i>.",
    words: [
      { tok: "tous mes envoûtements", desc: "<b>GN COD</b> — déterminant totalisant + possessif." }
    ],
    note: { label: "Chiasme", text: "Le <b>chiasme pronominal</b> crée une <b>réciprocité parfaite</b> : chacun connaît la magie de l'autre." }
  },
  {
    n: 16, c: 4,
    fr: "Tu m'as gardé de piège en piège",
    structure: "Passé composé avec <b>locution itérative</b>.",
