let currentAudio = null;

function speak(text, lang) {
  if (currentAudio) { try { currentAudio.pause(); } catch(e){} currentAudio = null; }
  const cleaned = text.replace(/<[^>]+>/g,'').replace(/\s+/g,' ').trim();
  if (!cleaned) return;
  const url = `https://translate.google.com/translate_tts?ie=UTF-8&q=${encodeURIComponent(cleaned)}&tl=${lang}&client=tw-ob`;
  try {
    currentAudio = new Audio(url);
    currentAudio.play().catch(()=>{
      if ('speechSynthesis' in window) {
        const u = new SpeechSynthesisUtterance(cleaned);
        u.lang = lang === 'he' ? 'he-IL' : 'fr-FR';
        speechSynthesis.speak(u);
      }
    });
  } catch(e) {
    if ('speechSynthesis' in window) {
      const u = new SpeechSynthesisUtterance(cleaned);
      u.lang = lang === 'he' ? 'he-IL' : 'fr-FR';
      speechSynthesis.speak(u);
    }
  }
}

function speakerSVG() {
  return '<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>';
}

async function playSequence(lines, lang, delay) {
  for (const t of lines) {
    speak(t, lang);
    await new Promise(r => setTimeout(r, delay));
  }
}

