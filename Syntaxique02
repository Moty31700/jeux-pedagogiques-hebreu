let tilesState = {};
function renderTiles() {
  const tiles = currentVersion === 'fr' ? TILES_FR : TILES_HE;
  const isHe = currentVersion === 'he';
  const lang = currentVersion;
  tilesState = {};

  let html = `<h2 class="section-title ${isHe?'he':''}">Reconstitue les phrases</h2>`;
  html += `<div class="tiles-instructions">Clique sur les tuiles pour les placer dans la zone de dépôt. Tu peux cliquer sur une tuile placée pour la retirer. Vérifie ta réponse avec le bouton « Vérifier ».</div>`;

  tiles.forEach((t, idx) => {
    tilesState[idx] = { placed: [], pool: [...t.tokens].sort(() => Math.random()-0.5) };
    const safeTarget = t.target.join(' ').replace(/`/g,'').replace(/'/g, "\\'");
    html += `<div class="tiles-exercise" data-idx="${idx}">`;
    html += `<div class="tiles-hint ${isHe?'he':''}">Phrase ${idx+1} — ${t.hint}</div>`;
    html += `<div class="tiles-translation">${t.fr}</div>`;
    html += `<div class="tiles-drop ${isHe?'he':''}" id="drop-${idx}"></div>`;
    html += `<div class="tile-pool ${isHe?'he':''}" id="pool-${idx}"></div>`;
    html += `<div class="tiles-controls">`;
    html += `<button class="tile-btn check" onclick="checkTiles(${idx})">Vérifier</button>`;
    html += `<button class="tile-btn" onclick="resetTiles(${idx})">↺ Réinitialiser</button>`;
    html += `<button class="tile-btn" onclick="speak('${safeTarget}', '${lang}')">${speakerSVG()} Écouter la solution</button>`;
    html += `</div>`;
    html += `<div class="tiles-feedback" id="fb-${idx}"></div>`;
    html += `</div>`;
  });
  return html;
}

function bindTiles() {
  const tiles = currentVersion === 'fr' ? TILES_FR : TILES_HE;
  const isHe = currentVersion === 'he';
  tiles.forEach((t, idx) => renderTileRow(idx, isHe));
}

function renderTileRow(idx, isHe) {
  const st = tilesState[idx];
  const drop = document.getElementById('drop-'+idx);
  const pool = document.getElementById('pool-'+idx);
  if (!drop || !pool) return;
  drop.innerHTML = st.placed.map((tk,i) =>
    `<button class="tile ${isHe?'he':''} placed" onclick="unplaceTile(${idx},${i})">${esc(tk)}</button>`
  ).join('');
  pool.innerHTML = st.pool.map((tk,i) => {
    const used = st.placed.includes(tk) && st.pool.filter(x=>x===tk).length<=st.placed.filter(x=>x===tk).length;
    // simpler approach: track usage by position
    return '';
  }).join('');
  // Rebuild pool with availability
  let counts = {};
  st.pool.forEach(tk => counts[tk] = (counts[tk]||0)+1);
  let placedCount = {};
  st.placed.forEach(tk => placedCount[tk] = (placedCount[tk]||0)+1);
  pool.innerHTML = st.pool.map((tk,i) => {
    const placedNum = placedCount[tk] || 0;
    placedCount[tk] = placedNum + 0; // don't decrement, we want all
    // Determine which copies are used
    const sameBefore = st.pool.slice(0,i).filter(x=>x===tk).length;
    const placedTotal = (st.placed.filter(x=>x===tk).length);
    const isUsed = sameBefore < placedTotal;
    return `<button class="tile ${isHe?'he':''} ${isUsed?'used':''}" onclick="placeTile(${idx},${i})">${esc(tk)}</button>`;
  }).join('');
}

function placeTile(idx, poolIdx) {
  const st = tilesState[idx];
  const tk = st.pool[poolIdx];
  // Count available
  const sameBefore = st.pool.slice(0,poolIdx).filter(x=>x===tk).length;
  const placedTotal = (st.placed.filter(x=>x===tk).length);
  if (sameBefore < placedTotal) return;
  st.placed.push(tk);
  const isHe = currentVersion === 'he';
  renderTileRow(idx, isHe);
}

function unplaceTile(idx, placedIdx) {
  const st = tilesState[idx];
  st.placed.splice(placedIdx, 1);
  const isHe = currentVersion === 'he';
  renderTileRow(idx, isHe);
}

function resetTiles(idx) {
  const tiles = currentVersion === 'fr' ? TILES_FR : TILES_HE;
  tilesState[idx].placed = [];
  document.getElementById('fb-'+idx).className = 'tiles-feedback';
  document.getElementById('fb-'+idx).textContent = '';
  const isHe = currentVersion === 'he';
  renderTileRow(idx, isHe);
}

function checkTiles(idx) {
  const tiles = currentVersion === 'fr' ? TILES_FR : TILES_HE;
  const t = tiles[idx];
  const st = tilesState[idx];
  const fb = document.getElementById('fb-'+idx);
  const correct = JSON.stringify(st.placed) === JSON.stringify(t.target);
  if (correct) {
    fb.className = 'tiles-feedback ok';
    fb.innerHTML = `✓ Bravo ! La phrase est correctement reconstituée.`;
  } else {
    fb.className = 'tiles-feedback err';
    fb.innerHTML = `✗ Pas encore. Solution : <b>${esc(t.target.join(' '))}</b>`;
  }
}

let lexFilter = 'all';
let lexQuery = '';
function renderLex() {
  const lex = currentVersion === 'fr' ? LEX_FR : LEX_HE;
  const isHe = currentVersion === 'he';
  const cats = [...new Set(lex.map(l => l.cat))];

  let html = `<h2 class="section-title ${isHe?'he':''}">Lexique syntaxique</h2>`;
  html += `<div class="analysis-intro">${lex.length} entrées. Cliquez sur un mot pour l'écouter.</div>`;
  html += `<div class="lex-toolbar">`;
  html += `<input class="lex-search" id="lex-search" placeholder="Rechercher un mot ou une catégorie…" value="${esc(lexQuery)}"/>`;
  html += `<button class="lex-filter ${lexFilter==='all'?'active':''}" onclick="setLexFilter('all')">Tous</button>`;
  html += `</div>`;
  html += `<div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px">`;
  cats.forEach(c => {
    html += `<button class="lex-filter ${lexFilter===c?'active':''}" onclick="setLexFilter('${c.replace(/'/g,"\\'")}')">${esc(c)}</button>`;
  });
  html += `</div>`;
  html += `<table class="lex-table ${isHe?'he':''}"><thead><tr><th>Mot / expression</th><th>Catégorie</th><th>Signification / note</th><th></th></tr></thead><tbody>`;
  const filtered = lex.filter(l => {
    if (lexFilter !== 'all' && l.cat !== lexFilter) return false;
    if (lexQuery && !(l.word + l.cat + l.meaning).toLowerCase().includes(lexQuery.toLowerCase())) return false;
    return true;
  });
  filtered.forEach(l => {
    const safe = l.word.replace(/`/g,'').replace(/'/g, "\\'");
    html += `<tr><td class="word">${esc(l.word)}</td><td class="cat">${esc(l.cat)}</td><td class="meaning">${esc(l.meaning)}</td>`;
    html += `<td><button class="speaker-btn ${isHe?'he':''}" onclick="speak('${safe}', '${currentVersion}')">${speakerSVG()}</button></td></tr>`;
  });
  html += `</tbody></table>`;
  if (!filtered.length) html += `<div style="margin-top:20px;text-align:center;color:var(--ink-soft);font-style:italic">Aucun résultat.</div>`;
  return html;
}
function bindLex() {
  const s = document.getElementById('lex-search');
  if (s) s.addEventListener('input', e => { lexQuery = e.target.value; document.getElementById('tab-content').innerHTML = renderLex(); bindLex(); s.focus(); });
}
function setLexFilter(f) {
  lexFilter = f;
  document.getElementById('tab-content').innerHTML = renderLex();
  bindLex();
}

