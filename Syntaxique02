<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analyse syntaxique — La chanson des vieux amants / אהבה בת עשרים</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Frank+Ruhl+Libre:wght@400;500;700;900&family=JetBrains+Mono:wght@400;600&display=swap');

* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #1a1320;
  --bg2: #2a1f33;
  --paper: #f4ecdb;
  --paper-warm: #ebdfc5;
  --ink: #2a1810;
  --ink-soft: #4a2e1c;
  --burgundy: #7a1f2e;
  --burgundy-light: #a83a4a;
  --gold: #c9a86a;
  --gold-bright: #e8c87a;
  --gold-dark: #8a6f3a;
  --rose: #c4748a;
  --olive: #6b6334;
  --shadow: rgba(20,10,5,.4);
  --accent-fr: #7a1f2e;
  --accent-he: #5a4e8a;
}

html, body {
  background: linear-gradient(135deg, #1a1320 0%, #2a1f33 50%, #1f1a2a 100%);
  min-height: 100vh;
  font-family: 'Cormorant Garamond', serif;
  color: var(--paper);
  overflow-x: hidden;
}

body::before {
  content: '';
  position: fixed; inset: 0;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(201,168,106,.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(196,116,138,.06) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

.app {
  position: relative;
  z-index: 1;
  max-width: 1100px;
  margin: 0 auto;
  padding: 20px 16px 80px;
}

/* ============ HEADER ============ */
.header {
  text-align: center;
  padding: 30px 20px 24px;
  margin-bottom: 20px;
  position: relative;
}
.header::after {
  content: '✦  ✦  ✦';
  display: block;
  color: var(--gold);
  letter-spacing: 1em;
  margin-top: 16px;
  font-size: 12px;
  opacity: .6;
}
.header h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  font-style: italic;
  font-size: 38px;
  color: var(--gold-bright);
  line-height: 1.1;
  margin-bottom: 8px;
  text-shadow: 0 2px 20px rgba(232,200,122,.3);
}
.header .sub {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 18px;
  color: var(--rose);
  margin-bottom: 4px;
}
.header .meta {
  font-size: 13px;
  color: var(--paper);
  opacity: .55;
  letter-spacing: .15em;
  text-transform: uppercase;
}

/* ============ MENU PRINCIPAL ============ */
.menu-screen {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 40px;
}
@media (max-width: 720px) {
  .menu-screen { grid-template-columns: 1fr; }
}

.menu-card {
  background: var(--paper);
  border-radius: 4px;
  padding: 36px 28px;
  position: relative;
  cursor: pointer;
  transition: transform .3s ease, box-shadow .3s ease;
  box-shadow: 0 12px 40px var(--shadow), 0 0 0 1px rgba(201,168,106,.2);
  overflow: hidden;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.menu-card::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(0,0,0,.12);
  pointer-events: none;
  border-radius: 2px;
}
.menu-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
}
.menu-card.fr::after { background: var(--accent-fr); }
.menu-card.he::after { background: var(--accent-he); }

.menu-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 60px var(--shadow), 0 0 0 1px var(--gold);
}

.menu-card .flag {
  font-size: 28px;
  margin-bottom: 8px;
  letter-spacing: .2em;
}
.menu-card.fr .flag { color: var(--accent-fr); }
.menu-card.he .flag { color: var(--accent-he); }

.menu-card h2 {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 700;
  color: var(--ink);
  font-size: 26px;
  line-height: 1.15;
  margin-bottom: 8px;
}
.menu-card.he h2 {
  font-family: 'Frank Ruhl Libre', serif;
  font-style: normal;
  font-weight: 700;
  direction: rtl;
  text-align: right;
}
.menu-card .author {
  font-style: italic;
  color: var(--ink-soft);
  font-size: 15px;
  margin-bottom: 16px;
}
.menu-card .desc {
  color: var(--ink-soft);
  font-size: 15px;
  line-height: 1.5;
  margin-bottom: 20px;
  font-family: 'Cormorant Garamond', serif;
}
.menu-card .badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 20px;
}
.badge {
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 12px;
  background: rgba(122,31,46,.1);
  color: var(--accent-fr);
  letter-spacing: .05em;
  font-family: 'JetBrains Mono', monospace;
  border: 1px solid rgba(122,31,46,.2);
}
.menu-card.he .badge {
  background: rgba(90,78,138,.1);
  color: var(--accent-he);
  border-color: rgba(90,78,138,.2);
}
.menu-card .enter {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: var(--gold-dark);
  font-size: 15px;
  letter-spacing: .1em;
  border-top: 1px solid rgba(0,0,0,.08);
  padding-top: 14px;
  text-align: center;
}
.menu-card .enter::after {
  content: ' →';
  transition: transform .3s ease;
  display: inline-block;
}
.menu-card:hover .enter::after {
  transform: translateX(6px);
}

.menu-compare {
  margin-top: 16px;
  text-align: center;
}
.compare-btn {
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold-bright);
  padding: 14px 32px;
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 17px;
  letter-spacing: .08em;
  cursor: pointer;
  border-radius: 2px;
  transition: all .25s ease;
}
.compare-btn:hover {
  background: var(--gold);
  color: var(--ink);
}

/* ============ HOME LINK ============ */
.home-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding: 0 4px;
}
.home-link {
  color: var(--gold-bright);
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 15px;
  cursor: pointer;
  letter-spacing: .05em;
  background: none;
  border: none;
  padding: 4px 8px;
}
.home-link:hover { color: var(--gold-bright); text-decoration: underline; }
.lang-pill {
  background: var(--accent-fr);
  color: var(--paper);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 12px;
  letter-spacing: .1em;
}
.lang-pill.he { background: var(--accent-he); }

/* ============ TABS ============ */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 0;
  background: rgba(244,236,219,.08);
  padding: 6px;
  border-radius: 6px 6px 0 0;
  border-bottom: 2px solid var(--gold-dark);
}
.tab {
  background: transparent;
  border: none;
  color: var(--paper);
  opacity: .65;
  padding: 12px 18px;
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .03em;
  cursor: pointer;
  border-radius: 4px 4px 0 0;
  transition: all .2s ease;
  flex: 1 1 auto;
  min-width: 120px;
  text-align: center;
}
.tab:hover { opacity: 1; background: rgba(244,236,219,.05); }
.tab.active {
  background: var(--paper);
  color: var(--ink);
  opacity: 1;
  font-weight: 700;
}
.tab-content {
  background: var(--paper);
  color: var(--ink);
  border-radius: 0 0 8px 8px;
  padding: 30px 28px;
  min-height: 400px;
  box-shadow: 0 12px 40px var(--shadow);
  position: relative;
}

/* ============ TEXTE + AUDIO ============ */
.poem-block {
  margin-bottom: 28px;
  padding: 20px 22px;
  background: var(--paper-warm);
  border-left: 3px solid var(--gold);
  border-radius: 2px;
  position: relative;
}
.poem-block.he {
  border-left: none;
  border-right: 3px solid var(--accent-he);
  direction: rtl;
  text-align: right;
}
.poem-block .label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  color: var(--gold-dark);
  margin-bottom: 12px;
  text-transform: uppercase;
}
.poem-line {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
  font-size: 19px;
  line-height: 1.7;
  color: var(--ink);
}
.poem-line.he {
  font-family: 'Frank Ruhl Libre', serif;
  font-size: 22px;
  flex-direction: row-reverse;
  justify-content: flex-end;
}
.poem-line .lnum {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--gold-dark);
  min-width: 28px;
  opacity: .7;
}
.poem-line .text {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  flex: 1;
}
.poem-line.he .text {
  font-family: 'Frank Ruhl Libre', serif;
  font-style: normal;
}
.speaker-btn {
  background: var(--burgundy);
  border: none;
  color: var(--paper);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all .2s ease;
  flex-shrink: 0;
}
.speaker-btn:hover { background: var(--burgundy-light); transform: scale(1.08); }
.speaker-btn.he { background: var(--accent-he); }
.speaker-btn.he:hover { background: #7868a5; }
.speaker-btn.big { width: 40px; height: 40px; }
.speaker-btn svg { width: 16px; height: 16px; fill: currentColor; }
.speaker-btn.big svg { width: 20px; height: 20px; }

.play-all {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 20px;
}
.play-all-btn {
  background: linear-gradient(135deg, var(--burgundy), var(--burgundy-light));
  color: var(--paper);
  border: none;
  padding: 10px 18px;
  border-radius: 4px;
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 15px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  letter-spacing: .03em;
  box-shadow: 0 4px 12px rgba(122,31,46,.3);
}
.play-all-btn.he {
  background: linear-gradient(135deg, var(--accent-he), #7868a5);
  box-shadow: 0 4px 12px rgba(90,78,138,.3);
}
.play-all-btn:hover { transform: translateY(-1px); }

/* ============ ANALYSE MOT À MOT ============ */
.analysis-intro {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 17px;
  color: var(--ink-soft);
  margin-bottom: 24px;
  padding: 14px 18px;
  background: rgba(201,168,106,.12);
  border-left: 3px solid var(--gold);
  line-height: 1.5;
}

.verse-section {
  margin-bottom: 28px;
  padding-bottom: 24px;
  border-bottom: 1px dashed rgba(0,0,0,.1);
}
.verse-section:last-child { border-bottom: none; }

.verse-header {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--burgundy);
  flex-wrap: wrap;
}
.verse-header.he { border-bottom-color: var(--accent-he); }
.verse-header .vnum {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--gold-dark);
  letter-spacing: .15em;
  text-transform: uppercase;
}
.verse-text {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 21px;
  color: var(--burgundy);
  font-weight: 700;
}
.verse-text.he {
  font-family: 'Frank Ruhl Libre', serif;
  font-style: normal;
  color: var(--accent-he);
  direction: rtl;
}

.verse-structure {
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  color: var(--ink-soft);
  margin-bottom: 14px;
  padding: 10px 14px;
  background: rgba(122,31,46,.05);
  border-radius: 4px;
  font-style: italic;
}
.verse-structure.he {
  background: rgba(90,78,138,.05);
}
.verse-structure b {
  font-style: normal;
  color: var(--burgundy);
  font-weight: 700;
}
.verse-structure.he b { color: var(--accent-he); }

.word-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.word-item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 14px;
  align-items: start;
  padding: 12px 14px;
  background: var(--paper-warm);
  border-radius: 4px;
  border-left: 3px solid transparent;
  transition: all .2s ease;
  cursor: pointer;
}
.word-item:hover {
  background: #e3d4b2;
  border-left-color: var(--gold);
}
.word-item.gem {
  background: linear-gradient(90deg, rgba(232,200,122,.18) 0%, var(--paper-warm) 100%);
  border-left-color: var(--gold);
}
.word-token {
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  font-size: 18px;
  color: var(--burgundy);
  min-width: 100px;
  white-space: nowrap;
}
.word-item.he .word-token {
  font-family: 'Frank Ruhl Libre', serif;
  font-size: 22px;
  color: var(--accent-he);
  direction: rtl;
  text-align: right;
}
.word-token .gem-icon {
  color: var(--gold-dark);
  font-size: 13px;
  margin-right: 4px;
}
.word-desc {
  font-family: 'Cormorant Garamond', serif;
  font-size: 15.5px;
  color: var(--ink);
  line-height: 1.5;
}
.word-desc b {
  color: var(--burgundy);
  font-weight: 700;
}
.word-item.he .word-desc b { color: var(--accent-he); }
.word-desc i {
  color: var(--olive);
  font-style: italic;
}
.word-desc .meaning {
  display: block;
  margin-top: 4px;
  color: var(--ink-soft);
  font-style: italic;
}

.style-note {
  margin-top: 20px;
  padding: 14px 18px;
  background: linear-gradient(135deg, rgba(196,116,138,.1), rgba(201,168,106,.1));
  border-left: 3px solid var(--rose);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 16px;
  line-height: 1.6;
  color: var(--ink-soft);
  border-radius: 2px;
}
.style-note b { color: var(--burgundy); font-style: normal; }
.style-note .label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  color: var(--gold-dark);
  text-transform: uppercase;
  font-style: normal;
  display: block;
  margin-bottom: 6px;
}

/* ============ TUILES ============ */
.tiles-instructions {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 16px;
  color: var(--ink-soft);
  margin-bottom: 18px;
  padding: 12px 16px;
  background: rgba(201,168,106,.1);
  border-radius: 4px;
}
.tiles-exercise {
  margin-bottom: 26px;
  padding: 18px;
  background: var(--paper-warm);
  border-radius: 6px;
  border: 1px solid rgba(0,0,0,.08);
}
.tiles-hint {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 16px;
  color: var(--burgundy);
  margin-bottom: 12px;
  line-height: 1.5;
}
.tiles-hint.he { color: var(--accent-he); }
.tiles-translation {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--ink-soft);
  margin-bottom: 14px;
  letter-spacing: .04em;
  opacity: .8;
}
.tiles-drop {
  min-height: 60px;
  padding: 12px 14px;
  background: var(--paper);
  border: 2px dashed var(--gold-dark);
  border-radius: 6px;
  margin-bottom: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}
.tiles-drop.he { direction: rtl; }
.tiles-drop:empty::before {
  content: '↓ Clique sur les tuiles pour reconstituer la phrase';
  color: var(--ink-soft);
  font-style: italic;
  opacity: .5;
  font-family: 'Cormorant Garamond', serif;
  font-size: 14px;
}
.tiles-drop.he:empty::before {
  content: '← לחץ על המשבצות לסידור המשפט';
  font-family: 'Frank Ruhl Libre', serif;
}
.tile-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}
.tile-pool.he { direction: rtl; justify-content: flex-end; }
.tile {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, var(--burgundy), var(--burgundy-light));
  color: var(--paper);
  padding: 8px 14px;
  border-radius: 4px;
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px;
  font-weight: 600;
  cursor: pointer;
  transition: all .2s ease;
  box-shadow: 0 3px 8px rgba(122,31,46,.3);
  user-select: none;
  border: none;
}
.tile.he {
  background: linear-gradient(135deg, var(--accent-he), #7868a5);
  font-family: 'Frank Ruhl Libre', serif;
  font-size: 20px;
  box-shadow: 0 3px 8px rgba(90,78,138,.3);
}
.tile:hover { transform: translateY(-2px); box-shadow: 0 5px 12px rgba(122,31,46,.4); }
.tile.he:hover { box-shadow: 0 5px 12px rgba(90,78,138,.4); }
.tile.placed { background: var(--gold-dark); }
.tile.placed.he { background: #8a7a4a; }
.tile.used { opacity: .25; pointer-events: none; }

.tiles-controls { display: flex; gap: 8px; flex-wrap: wrap; }
.tile-btn {
  padding: 7px 14px;
  font-size: 13px;
  border: 1px solid var(--ink-soft);
  background: transparent;
  color: var(--ink-soft);
  border-radius: 4px;
  cursor: pointer;
  font-family: 'Cormorant Garamond', serif;
  letter-spacing: .03em;
}
.tile-btn:hover { background: var(--ink-soft); color: var(--paper); }
.tile-btn.check {
  background: var(--burgundy);
  color: var(--paper);
  border-color: var(--burgundy);
}
.tile-btn.check:hover { background: var(--burgundy-light); }
.tiles-feedback {
  margin-top: 12px;
  padding: 10px 14px;
  border-radius: 4px;
  font-family: 'Cormorant Garamond', serif;
  font-size: 15px;
  display: none;
}
.tiles-feedback.ok { background: rgba(107,99,52,.15); color: var(--olive); border-left: 3px solid var(--olive); display: block; }
.tiles-feedback.err { background: rgba(122,31,46,.1); color: var(--burgundy); border-left: 3px solid var(--burgundy); display: block; }

/* ============ LEXIQUE ============ */
.lex-toolbar {
  display: flex;
  gap: 10px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.lex-search {
  flex: 1;
  min-width: 200px;
  padding: 10px 14px;
  border: 1px solid var(--gold-dark);
  background: var(--paper-warm);
  color: var(--ink);
  border-radius: 4px;
  font-family: 'Cormorant Garamond', serif;
  font-size: 15px;
}
.lex-search:focus { outline: none; border-color: var(--burgundy); }
.lex-filter {
  padding: 8px 14px;
  background: transparent;
  border: 1px solid var(--gold-dark);
  color: var(--ink);
  border-radius: 4px;
  cursor: pointer;
  font-family: 'Cormorant Garamond', serif;
  font-size: 14px;
}
.lex-filter.active { background: var(--burgundy); color: var(--paper); border-color: var(--burgundy); }

.lex-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--paper);
}
.lex-table thead tr {
  background: var(--burgundy);
  color: var(--paper);
}
.lex-table.he thead tr { background: var(--accent-he); }
.lex-table th {
  padding: 10px 12px;
  text-align: left;
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 14px;
  font-weight: 700;
}
.lex-table td {
  padding: 11px 12px;
  border-bottom: 1px solid rgba(0,0,0,.08);
  font-family: 'Cormorant Garamond', serif;
  font-size: 15px;
  vertical-align: top;
}
.lex-table tbody tr:hover { background: var(--paper-warm); }
.lex-table .word {
  font-weight: 700;
  color: var(--burgundy);
  font-size: 16px;
}
.lex-table.he .word {
  color: var(--accent-he);
  font-family: 'Frank Ruhl Libre', serif;
  font-size: 19px;
  direction: rtl;
  text-align: right;
}
.lex-table .cat {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--olive);
