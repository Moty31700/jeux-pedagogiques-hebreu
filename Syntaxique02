}
function bindQuiz() {}
function answerQuiz(i) {
  if (quizState.answered) return;
  quizState.answered = true;
  const quiz = currentVersion === 'fr' ? QUIZ_FR : QUIZ_HE;
  const q = quiz[quizState.idx];
  document.querySelectorAll('.quiz-option').forEach(b => b.disabled = true);
  const chosen = document.querySelector(`.quiz-option[data-i="${i}"]`);
  const correct = document.querySelector(`.quiz-option[data-i="${q.ans}"]`);
  const fb = document.getElementById('quiz-fb');
  if (i === q.ans) {
    chosen.classList.add('correct');
    fb.className = 'quiz-feedback ok';
    fb.innerHTML = '✓ Correct. ' + q.ex;
    quizState.score++;
  } else {
    chosen.classList.add('wrong');
    correct.classList.add('correct');
    fb.className = 'quiz-feedback err';
    fb.innerHTML = '✗ Pas tout à fait. ' + q.ex;
  }
  document.getElementById('quiz-next').style.display = 'inline-block';
  // Update score display immediately
  document.querySelector('.score-display').textContent = 'Score : ' + quizState.score;
}
function nextQuiz() {
  quizState.idx++;
  quizState.answered = false;
  document.getElementById('tab-content').innerHTML = renderQuizCurrent();
}

function renderIndex() {
  const idx = currentVersion === 'fr' ? INDEX_FR : INDEX_HE;
  const isHe = currentVersion === 'he';
  let html = `<h2 class="section-title ${isHe?'he':''}">Index des termes syntaxiques</h2>`;
  html += `<div class="analysis-intro">Index thématique des notions de grammaire et de stylistique abordées.</div>`;
  idx.forEach(sec => {
    html += `<div class="idx-section-title">${esc(sec.sec)}</div>`;
    html += `<div class="idx-grid">`;
    sec.items.forEach(it => {
      html += `<div class="idx-card ${isHe?'he':''}"><div class="idx-term">${esc(it.term)}</div><div class="idx-def">${esc(it.def)}</div></div>`;
    });
    html += `</div>`;
  });
  return html;
}

function renderComparison() {
  let html = `<h2 class="section-title">Comparaison des deux versions</h2>`;
  html += `<div class="analysis-intro">Étude comparative point par point : où Shemer reste-t-elle fidèle à Brel, et où s'en écarte-t-elle ? Chaque tableau confronte un trait syntaxique des deux versions.</div>`;
  COMPARISONS.forEach(comp => {
    html += `<div class="comp-block">`;
    html += `<h3>${esc(comp.title)}</h3>`;
    html += `<div class="lead">${comp.lead}</div>`;
    comp.blocks.forEach(b => {
      html += `<div class="comp-grid">`;
      html += `<div class="comp-col fr"><h4>Français — Brel</h4><div class="ex">${b.fr.ex}</div><div class="note">${b.fr.note}</div></div>`;
      html += `<div class="comp-col he"><h4>עברית — שמר</h4><div class="ex">${b.he.ex}</div><div class="note">${b.he.note}</div></div>`;
      html += `</div>`;
    });
    html += `</div>`;
  });
  // Conclusion
  html += `<div class="comp-block">`;
  html += `<h3>Conclusion</h3>`;
  html += `<div class="lead">La traduction de Naomi Shemer n'est ni littérale ni infidèle : elle est <b>recréative</b>. Là où <b>Brel raconte</b> une histoire d'amour avec narrateur, distance temporelle et oralité, <b>Shemer médite</b> avec présent durable, méditation sur le temps et registre soutenu. Deux poètes, deux langues, deux poèmes apparentés qui parlent de la persistance miraculeuse de l'amour à travers les épreuves — mais avec des <b>moyens syntaxiques irréductiblement différents</b>.</div>`;
  html += `<div class="lead" style="font-style:italic;color:var(--burgundy)">C'est peut-être là le paradoxe de la traduction poétique réussie : il faut <b>trahir</b> la lettre pour préserver l'esprit, et accepter que la version d'arrivée devienne <b>une autre œuvre</b> qui dialogue avec l'original sans se confondre avec lui.</div>`;
  html += `</div>`;
  return html;
}

function renderIndexBoth() {
  let html = `<h2 class="section-title">Index syntaxique croisé</h2>`;
  html += `<div class="analysis-intro">Index des notions abordées dans les deux versions, côte à côte.</div>`;
  html += `<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">`;

  html += `<div>`;
  html += `<h3 style="font-family:'Playfair Display',serif;font-style:italic;color:var(--accent-fr);margin-bottom:10px;border-bottom:2px solid var(--accent-fr);padding-bottom:4px">FR — Brel</h3>`;
  INDEX_FR.forEach(sec => {
    html += `<div class="idx-section-title" style="font-size:16px">${esc(sec.sec)}</div>`;
    sec.items.forEach(it => {
      html += `<div style="padding:6px 10px;margin-bottom:4px;background:var(--paper-warm);border-left:2px solid var(--accent-fr);border-radius:2px"><b style="color:var(--accent-fr)">${esc(it.term)}</b> <span style="font-size:14px;color:var(--ink-soft);font-style:italic">— ${esc(it.def)}</span></div>`;
    });
  });
  html += `</div>`;

  html += `<div>`;
  html += `<h3 style="font-family:'Playfair Display',serif;font-style:italic;color:var(--accent-he);margin-bottom:10px;border-bottom:2px solid var(--accent-he);padding-bottom:4px">HE — Shemer</h3>`;
  INDEX_HE.forEach(sec => {
    html += `<div class="idx-section-title" style="font-size:16px;color:var(--accent-he);border-bottom-color:var(--accent-he)">${esc(sec.sec)}</div>`;
    sec.items.forEach(it => {
      html += `<div style="padding:6px 10px;margin-bottom:4px;background:var(--paper-warm);border-left:2px solid var(--accent-he);border-radius:2px"><b style="color:var(--accent-he)">${esc(it.term)}</b> <span style="font-size:14px;color:var(--ink-soft);font-style:italic">— ${esc(it.def)}</span></div>`;
    });
  });
  html += `</div>`;

  html += `</div>`;
  return html;
}

