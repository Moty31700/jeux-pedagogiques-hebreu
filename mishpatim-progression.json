          "name": "Supabase account"
        }
      },
      "parameters": {
        "operation": "getAll",
        "tableId": "utilisateurs",
        "limit": 1,
        "filters": {
          "conditions": [
            {
              "keyName": "identifiant",
              "condition": "eq",
