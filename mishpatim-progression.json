    },
    {
      "id": "bcb8db92-4308-48c9-b874-6c306bd80ab7",
      "name": "Contrôle accès",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Contrôle d'accès « progression » : mêmes règles que Mishpatim IA, sans onglet ni quota\nconst b = $('Webhook progression').first().json.body || {};\nconst e = $input.all().map(i => i.json).find(x => x && x.id) || null;\nconst FORMULES = ['sectoriel', 'complet'];\nconst CLE = /^(mp3\\.|mishpatim-)[A-Za-z0-9_.-]{1,60}$/;\nconst MAX = 4000000;   // 4 Mo de progression au plus par envoi\nconst type = String(b.type || '');\nconst maintenant = new Date();\nlet erreur = '', message = '';\nlet set = {}, del = [];\n\nif (!b.identifiant || !b.code || !['lire', 'ecrire'].includes(type)) {\n  erreur = 'requete_invalide'; message = 'Demande incomplète.';\n} else if (!e || String(e.code_acces || '') !== String(b.code).trim()) {\n  erreur = 'code_invalide'; message = 'Identifiant ou code incorrect. Reconnectez-vous.';\n} else if (e.code_expire_le && new Date(e.code_expire_le) < maintenant) {\n  erreur = 'code_expire'; message = 'Votre code a expiré. Demandez-en un nouveau depuis la page de connexion.';\n} else if (!FORMULES.includes(e.formule)) {\n  erreur = 'pas_abonne'; message = 'Mishpatim est réservé aux abonnements Sectoriel et Complet.';\n} else if (!e.mishpatim_fin || new Date(e.mishpatim_fin) < maintenant) {\n  erreur = 'abonnement_expire'; message = \"Votre abonnement Mishpatim n'est plus actif. Renouvelez-le pour continuer.\";\n} else if (type === 'ecrire') {\n  set = b.set && typeof b.set === 'object' && !Array.isArray(b.set) ? b.set : {};\n  del = Array.isArray(b.del) ? b.del : [];\n  const cles = Object.keys(set).concat(del);\n  if (!cles.length || cles.length > 200 || !cles.every(k => typeof k === 'string' && CLE.test(k))) {\n    erreur = 'requete_invalide'; message = 'Progression illisible.';\n  } else if (JSON.stringify(set).length > MAX) {\n    erreur = 'trop_gros'; message = 'Progression trop volumineuse pour être enregistrée.';\n  }\n}\n\nreturn [{ json: { ok: !erreur, erreur, message, type, utilisateur_id: e ? e.id : null, set, del } }];"
      }
    },
    {
      "id": "27a39ad3-5b2a-49dc-8c97-4d70077beb9e",
