    {
      "id": "95996dd2-0b63-4cc2-ad0a-54c30c03df94",
      "name": "Préparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ],
      "parameters": {
        "jsCode": "// Fusionne les clés envoyées avec la progression déjà enregistrée\nconst c = $('Contrôle accès').first().json;\nconst ligne = $input.all().map(i => i.json).find(x => x && x.utilisateur_id) || null;\nconst actuel = ligne && ligne.donnees && typeof ligne.donnees === 'object' ? ligne.donnees : {};\n\nif (c.type === 'lire') {\n  return [{ json: { action: 'lire', reponse: { ok: true, donnees: actuel, maj: ligne ? ligne.maj_le : null } } }];\n}\nconst donnees = { ...actuel };\nfor (const [k, v] of Object.entries(c.set)) donnees[k] = v;\nfor (const k of c.del) delete donnees[k];\nconst maj = new Date().toISOString();\nreturn [{ json: {\n  action: ligne ? 'maj' : 'creer',\n  ligne: { utilisateur_id: c.utilisateur_id, donnees, maj_le: maj },\n  reponse: { ok: true, maj }\n} }];"
      }
    },
